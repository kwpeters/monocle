# EditorConfig overrides for test projects
root = false

[*.cs]
# Disable expression-bodied methods suggestion for test code
# Test methods should use block bodies for clarity
dotnet_diagnostic.IDE0022.severity = none

# Test readability more important than micro-optimization
dotnet_diagnostic.CA1861.severity = none

# String comparison clarity not needed in tests
dotnet_diagnostic.CA1307.severity = none
